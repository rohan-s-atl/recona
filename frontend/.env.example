# ── Anthropic ────────────────────────────────────────────────────────────────
# Required — powers column mapping, fuzzy matching, and executive summaries
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ─────────────────────────────────────────────────────────────────
# Optional — enables run persistence, /runs history, and permanent run URLs
# 1. Create a project at https://supabase.com
# 2. Run docs/schema.sql against your project (SQL Editor → New Query)
# 3. Run docs/schema-v2.sql for the auth columns migration
# 4. Find these values at Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Use the service role key for server-side writes (never expose to browser)
# Project Settings → API → service_role (keep this secret)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Clerk (Auth) ──────────────────────────────────────────────────────────────
# Required for user authentication (email/password + Google SSO)
# 1. Create an app at https://clerk.com
# 2. Copy keys from Clerk Dashboard → API Keys
# 3. Set NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY below
# 4. Optional: enable Google as a social provider in Clerk Dashboard → SSO Connections

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Role setup ────────────────────────────────────────────────────────────────
# Roles: admin | analyst (default) | viewer
# Set a user's role in Clerk Dashboard → Users → select user → Metadata → Public:
#   { "role": "admin" }
# Admin: access to audit log + all actions
# Analyst: run reconciliations, view results, export
# Viewer: view results only

# Monitoring (Sentry)
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Background queue (BullMQ/Redis; required before moving large jobs off Next API routes)
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
INTERNAL_WORKER_SECRET=change-me
REDIS_URL=
# Optional if using Upstash REST for health/config visibility
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
